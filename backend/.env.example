# Copy to .env.local for `npm run dev`. On Vercel, set these in Project → Settings → Environment Variables.
GEMINI_API_KEY=your-key-here
INVITE_CODE=choose-a-code
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TEMPERATURE=0.2
# minimal | low | medium | high | default
GEMINI_THINKING=low
SCANS_PER_DAY=20
MOCK=1
# Added automatically when you connect Upstash Redis from the Vercel Marketplace.
# Leave empty locally to use an in-memory store.
KV_REST_API_URL=
KV_REST_API_TOKEN=
